datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  auditLogs  AuditLog[]
  watchlists Watchlist[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  itemValue String   // The IP, domain, hash, or email
  itemType  String   // 'ip', 'domain', 'hash', 'email'
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

model IpCache {
  ip          String   @id
  threatScore Float
  data        String   // Full JSON response stringified
  updatedAt   DateTime @updatedAt
}

model DomainCache {
  domain      String   @id
  threatScore Float
  data        String
  updatedAt   DateTime @updatedAt
}

model HashCache {
  hash        String   @id
  threatScore Float
  data        String
  updatedAt   DateTime @updatedAt
}

model EmailCache {
  email       String   @id
  threatScore Float
  data        String
  updatedAt   DateTime @updatedAt
}
